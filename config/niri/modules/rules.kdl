prefer-no-csd

// Window rules.

// Base window rounding & opacity.
// 17 to match Hyprland's decoration:rounding. Niri has no rounding_power, so
// these corners stay circular where Hyprland's are a superellipse.
window-rule {
    geometry-corner-radius 17
    clip-to-geometry true
    opacity 0.9 // Inactive opacity.
    popups {
        geometry-corner-radius 12
        background-effect {
            blur true
            xray false
        }
    }
}

// Active window opacity.
window-rule {
    match is-active=true
    opacity 1.0
}

// Inactive window opacity and blur.
window-rule {
    match is-active=false

    background-effect {
        blur true
        xray false
    }
}

// Opaque Browsers/Players.
window-rule {
    match app-id=r#"^(mpv|zen|librewolf|firefox|brave|chrome|chromium)$"#
    opacity 1.0
}

// XWayland Drag Fix.
window-rule {
    match title="^$" app-id="^$"
    block-out-from "screen-capture"
}

// Polkit Authentication Dialogs.
window-rule {
    match app-id=r#"^(polkit-gnome-authentication-agent-1|hyprpolkitagent)$"#
    open-floating true
    opacity 0.8
    background-effect {
        blur true // Emulates "dim_around" with a beautiful glass effect.
        xray false
    }
}

// Terminals.
// Rofi's Wayland layer blur is rectangular. As an XWayland window, Niri can
// clip the same blur to the rounded window geometry instead.
window-rule {
    match app-id="^Rofi$"
    open-floating true
    geometry-corner-radius 12
    clip-to-geometry true
    focus-ring { off; }
    border { off; }
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="floating"
    open-floating true
}

window-rule {
    match app-id=r#"^(org\.wezfurlong\.wezterm|kitty)$"#
    background-effect {
        blur true
        xray false
    }
}

// Layer rules.
layer-rule {
    // Rofi has rounded transparent corners; Niri's layer blur would draw a
    // rectangle behind them (layer corner-radius only affects shadows).
    match namespace=r#"^(waybar|logout_dialog)$"#
    background-effect {
        blur true
        xray false
    }
}

// SwayNC has some errors in blur integration currently.
/-layer-rule {
    match namespace=r#"^(swaync-control-center|swaync-notification-window)$"#
    background-effect {
        blur true
        xray false
    }
}
layer-rule {
    match namespace=r#"^noctalia-(bar-.+|notification|dock|panel)$"#
    background-effect {
        blur true
        xray false
    }
    popups {
        background-effect {
            blur true
            xray false
        }
    }
}
